# 홈랩 클러스터(NodePort) 실습 환경변수: 저장소 루트에서 `source homelab.env`
# 노드 IP 는 아무거나 (192.168.0.31~34)
HOMELAB_NODE="${HOMELAB_NODE:-192.168.0.32}"
export KUBECONFIG="${KUBECONFIG:-$HOME/.kube/homelab.conf}"

# 오브젝트 저장소 = SeaweedFS (책의 MinIO 대체), NodePort 30900
# SeaweedFS 는 S3 호환 API 를 제공하므로 클라이언트(boto3, minio, Feast)가 쓰는 AWS_* 이름의 변수로 설정 (AWS 와는 무관)
# 키는 책과 같은 kubeflow/manifests 기본값
export AWS_ACCESS_KEY_ID=minio
export AWS_SECRET_ACCESS_KEY=minio123
export AWS_DEFAULT_REGION=us-east-1
export AWS_ENDPOINT_URL="http://$HOMELAB_NODE:30900"
export FEAST_S3_ENDPOINT_URL="$AWS_ENDPOINT_URL"

# MLflow, NodePort 30500. 서버가 내려주는 다운로드용 presigned URL 은 클러스터 내부 주소라
# PC 에서 열 수 없음 → 아티팩트 다운로드를 MLflow 서버를 거쳐 받도록 끔
export MLFLOW_TRACKING_URI="http://$HOMELAB_NODE:30500"
export MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
export MLFLOW_DISABLE_AGENT_HINT=1

# Valkey (책의 Redis 대체), NodePort 30379. feast/feature_store.yaml 의 ${VALKEY_ADDR}, ${VALKEY_PASSWORD}
export VALKEY_ADDR="$HOMELAB_NODE:30379"
VALKEY_PASSWORD="$(kubectl -n mlops get secret valkey -o jsonpath='{.data.VALKEY_PASSWORD}' | base64 -d)"
export VALKEY_PASSWORD
